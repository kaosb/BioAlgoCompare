# BioAlgoCompare Environment Configuration
# Copy this file to .env and adjust values as needed

# Environment type
BIOALGO_ENV=development  # Options: development, testing, production

# Logging
BIOALGO_LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
BIOALGO_LOG_FILE=bioalgo.log
BIOALGO_LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Paths
BIOALGO_DATA_PATH=./data
BIOALGO_RESULTS_PATH=./results
BIOALGO_CACHE_PATH=./.cache
BIOALGO_TEMP_PATH=/tmp/bioalgo

# Performance
BIOALGO_MAX_WORKERS=0  # 0 = auto-detect CPU cores
BIOALGO_CHUNK_SIZE=1000
BIOALGO_MEMORY_LIMIT=8G

# Reproducibility
BIOALGO_DEFAULT_SEED=42
BIOALGO_ENFORCE_REPRODUCIBILITY=true
PYTHONHASHSEED=0

# Quality Gates
BIOALGO_QUALITY_REQUIRED_ONLY=false
BIOALGO_QUALITY_FAIL_FAST=false
BIOALGO_MAX_COMPLEXITY=15

# Database (optional)
DATABASE_URL=postgresql://bioalgo:bioalgo2024@localhost:5432/bioalgo_results
REDIS_URL=redis://localhost:6379/0

# Jupyter
JUPYTER_ENABLE_LAB=yes
JUPYTER_TOKEN=bioalgo2024
JUPYTER_PORT=8888

# API Keys (if needed for external services)
# OPENAI_API_KEY=your-key-here
# WANDB_API_KEY=your-key-here

# Development
BIOALGO_DEBUG=false
BIOALGO_PROFILE=false
BIOALGO_TRACE_MALLOC=false

# Export settings
BIOALGO_EXPORT_FORMAT=csv,json
BIOALGO_EXPORT_COMPRESSION=gzip
BIOALGO_FIGURE_DPI=300
BIOALGO_FIGURE_FORMAT=png,pdf

# Notification settings (optional)
# BIOALGO_NOTIFY_EMAIL=your-email@example.com
# BIOALGO_NOTIFY_SLACK_WEBHOOK=https://hooks.slack.com/services/...

# Resource limits
BIOALGO_TIMEOUT_SECONDS=3600  # 1 hour
BIOALGO_MAX_ITERATIONS=10000
BIOALGO_MAX_POPULATION_SIZE=1000
+def calculate_hypervolume(pareto_front, reference_point=None):
+    """
+    Calcula el hipervolumen de un frente de Pareto.
+
+    Args:
+        pareto_front: Lista de soluciones [(obj1, obj2, obj3), ...]
+        reference_point: Punto de referencia (peor caso)
+
+    Returns:
+        float: Valor del hipervolumen
+    """
+    if not pareto_front:
+        return 0.0
+
+    # Si DEAP está disponible, usar su implementación
+    if deap_hypervolume:
+        if reference_point is None:
+            # Calcular punto de referencia automáticamente
+            max_obj1 = max(s[0] for s in pareto_front) * 1.1
+            max_obj2 = max(s[1] for s in pareto_front) * 1.1
+            max_obj3 = max(s[2] for s in pareto_front) * 1.1
+            reference_point = [max_obj1, max_obj2, max_obj3]
+
+        hv = deap_hypervolume.Hypervolume(reference_point)
+        return hv.compute(pareto_front)
+    else:
+        # Implementación simplificada si DEAP no está disponible
+        logger.warning("DEAP not available, using simplified hypervolume calculation")
+        if reference_point is None:
+            reference_point = [
+                max(s[0] for s in pareto_front) * 1.1,
+                max(s[1] for s in pareto_front) * 1.1,
+                max(s[2] for s in pareto_front) * 1.1
+            ]
+
+        # Aproximación simple: suma de volúmenes dominados
+        volume = 0.0
+        for sol in pareto_front:
+            vol = 1.0
+            for i in range(3):
+                diff = reference_point[i] - sol[i]
+                if diff > 0:
+                    vol *= diff
+                else:
+                    vol = 0
+                    break
+            volume += vol
+        return volume
+
+
+def calculate_igd(pareto_front, reference_set):
+    """
+    Calcula el Inverted Generational Distance (IGD).
+
+    Args:
+        pareto_front: Frente de Pareto obtenido
+        reference_set: Conjunto de referencia (Pareto óptimo conocido)
+
+    Returns:
+        float: Valor del IGD
+    """
+    if not pareto_front or not reference_set:
+        return float('inf')
+
+    total_distance = 0.0
+    for ref_point in reference_set:
+        min_distance = float('inf')
+        for sol in pareto_front:
+            # Distancia euclidiana
+            distance = sum((ref_point[i] - sol[i])**2 for i in range(len(ref_point)))
+            distance = sqrt(distance)
+            min_distance = min(min_distance, distance)
+        total_distance += min_distance
+
+    return total_distance / len(reference_set)
+
+
+def simulate_dynamic_demands(problem, lambda_rate=10, time_horizon=480, seed=None):
+    """
+    Simula demandas dinámicas siguiendo un proceso de Poisson.
+
+    Args:
+        problem: Instancia de VRPProblem
+        lambda_rate: Tasa de llegada de Poisson (pedidos/hora)
+        time_horizon: Horizonte temporal en minutos
+        seed: Semilla para reproducibilidad
+
+    Returns:
+        list: Lista de nuevos pedidos con timestamps
+    """
+    if seed is not None:
+        np.random.seed(seed)
+
+    dynamic_orders = []
+    current_time = 0
+
+    while current_time < time_horizon:
+        # Tiempo hasta siguiente pedido (exponencial)
+        interval = np.random.exponential(60 / lambda_rate)  # en minutos
+        current_time += interval
+
+        if current_time < time_horizon:
+            # Generar nuevo pedido
+            customer_id = np.random.randint(1, problem.dimension)
+            demand = np.random.randint(5, 20)
+
+            order = {
+                'customer_id': customer_id,
+                'demand': demand,
+                'arrival_time': current_time,
+                'coord': problem.nodes[customer_id] if hasattr(problem, 'nodes') else (0, 0),
+                'time_window': (current_time, current_time + 120),  # 2 horas de ventana
+            }
+            dynamic_orders.append(order)
+
+    return dynamic_orders
+

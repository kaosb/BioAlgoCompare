+            latex_code.append("\\end{tabular}")
+            latex_code.append("\\end{table}")
+
+        # Join all code
+        latex_str = "\n".join(latex_code)
+
+        # Save to file if requested
+        if output_file:
+            with open(output_file, 'w') as f:
+                f.write(latex_str)

+    def multiobjective_quality_indicators(self, algorithm: str) -> Dict[str, Any]:
+        """
+        Calculate multi-objective quality indicators for an algorithm.
+
+        Args:
+            algorithm: Algorithm name
+
+        Returns:
+            Dictionary with quality indicators
+        """
+        if not self.multiobjective:
+            return {"error": "Not configured for multi-objective analysis"}
+
+        results = {}
+
+        # Filter data for this algorithm
+        algo_data = self.results_df[self.results_df[self.algorithm_col] == algorithm]
+
+        # Hypervolume statistics
+        if hasattr(self, 'hypervolume_col'):
+            hv_values = algo_data[self.hypervolume_col].values
+            results['hypervolume'] = {
+                'mean': np.mean(hv_values),
+                'std': np.std(hv_values),
+                'min': np.min(hv_values),
+                'max': np.max(hv_values),
+                'median': np.median(hv_values),
+            }
+
+        # IGD statistics
+        if hasattr(self, 'igd_col'):
+            igd_values = algo_data[self.igd_col].values
+            results['igd'] = {
+                'mean': np.mean(igd_values),
+                'std': np.std(igd_values),
+                'min': np.min(igd_values),
+                'max': np.max(igd_values),
+                'median': np.median(igd_values),
+            }
+
+        # QC-DVRP specific metrics
+        if 'OnTimeRate' in algo_data.columns:
+            results['on_time_delivery'] = {
+                'mean': algo_data['OnTimeRate'].mean(),
+                'std': algo_data['OnTimeRate'].std(),
+            }
+
+        if 'LoadVariation' in algo_data.columns:
+            results['load_balance'] = {
+                'mean': algo_data['LoadVariation'].mean(),
+                'std': algo_data['LoadVariation'].std(),
+            }
+
+        return results
+

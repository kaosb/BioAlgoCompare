+def analyze_multiobjective_results(
+    results_df: pd.DataFrame,
+    objectives: List[str] = ["DeliveryTime", "LoadVariation", "Distance"],
+    reference_point: List[float] = None,
+    output_dir: str = ".",
+) -> Dict[str, Any]:
+    """
+    Analyze multi-objective optimization results.
+
+    Args:
+        results_df: DataFrame with multi-objective results
+        objectives: Column names for objectives
+        reference_point: Reference point for hypervolume
+        output_dir: Directory to save results
+
+    Returns:
+        Dictionary with analysis results
+    """
+    analysis = {}
+
+    # Group by algorithm
+    algorithms = results_df['Algorithm'].unique()
+
+    for algo in algorithms:
+        algo_data = results_df[results_df['Algorithm'] == algo]
+
+        # Extract Pareto fronts
+        pareto_fronts = []
+        for _, row in algo_data.iterrows():
+            if all(obj in row for obj in objectives):
+                pareto_fronts.append([row[obj] for obj in objectives])
+
+        # Calculate hypervolume
+        if pareto_fronts:
+            hv = calculate_hypervolume(pareto_fronts, reference_point)
+            analysis[algo] = {
+                'hypervolume': hv,
+                'pareto_size': len(pareto_fronts),
+                'objectives': {
+                    obj: {
+                        'mean': algo_data[obj].mean() if obj in algo_data else None,
+                        'std': algo_data[obj].std() if obj in algo_data else None,
+                        'min': algo_data[obj].min() if obj in algo_data else None,
+                        'max': algo_data[obj].max() if obj in algo_data else None,
+                    }
+                    for obj in objectives
+                }
+            }
+
+    # Save results
+    output_path = Path(output_dir)
+    output_path.mkdir(parents=True, exist_ok=True)
+
+    with open(output_path / "multiobjective_analysis.json", 'w') as f:
+        json.dump(analysis, f, indent=2)
+
+    # Generate comparison plot
+    # ... (visualization code here)
+
+    return analysis
+
+
